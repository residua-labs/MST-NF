import MSTNF.algorithms.MSTNFHopComposeMWE

/-!
# Observation order for MST-NF hops

A projector records the part of an outcome a client can distinguish. The
order points from coarser to finer: equality for the finer view implies
equality for the coarser view. Quotienting mutually refining projectors
forgets the names of their views. Neither a choice of representatives nor
decidability of equality is needed for this lattice. Decidable view
equality enters only at the interface to the existing Boolean hop check.
-/

namespace NfCompose.Observation

open MSTNecessityExecModelMWE

structure Projection (O : Type) where
  View : Type
  read : O → View

variable {O X Y : Type}

def Coarser (p q : Projection O) : Prop :=
  ∀ x y, q.read x = q.read y → p.read x = p.read y

theorem preorder_laws (O : Type) :
    (∀ p : Projection O, Coarser p p) ∧
    (∀ p q r : Projection O, Coarser p q → Coarser q r → Coarser p r) :=
  ⟨fun _ _ _ h => h, fun _ _ _ hp hq x y h => hp x y (hq x y h)⟩

/-- A supplied forgetful map gives an information inequality, even when
    the declared view type contains readings no outcome attains. -/
theorem coarser_of_factor (p q : Projection O) (f : q.View → p.View)
    (hf : ∀ x, f (q.read x) = p.read x) : Coarser p q :=
  fun x y h => (hf x).symm.trans ((congrArg f h).trans (hf y))

def mutualRefinement (O : Type) : Setoid (Projection O) where
  r := fun p q => Coarser p q ∧ Coarser q p
  iseqv := ⟨fun p => ⟨(preorder_laws O).1 p, (preorder_laws O).1 p⟩,
    fun h => ⟨h.2, h.1⟩,
    fun h k => ⟨(preorder_laws O).2 _ _ _ h.1 k.1,
      (preorder_laws O).2 _ _ _ k.2 h.2⟩⟩

def Information (O : Type) := Quotient (mutualRefinement O)

def classOf (p : Projection O) : Information O := Quotient.mk _ p

/-- Equality of readings is independent of the representative projector. -/
def agrees (i : Information O) (x y : O) : Prop :=
  Quotient.liftOn i (fun p => p.read x = p.read y)
    (fun _ _ h => propext ⟨h.2 x y, h.1 x y⟩)

def kernel (i : Information O) : Setoid O where
  r := agrees i
  iseqv := by
    induction i using Quotient.inductionOn with
    | _ p =>
      change Equivalence (fun x y => p.read x = p.read y)
      exact ⟨fun _ => rfl, fun h => h.symm, fun h k => h.trans k⟩

/-- On classes of concrete projectors this is definitionally `Coarser`. -/
def Below (i j : Information O) : Prop :=
  ∀ x y, agrees j x y → agrees i x y

theorem quotient_order (O : Type) :
    (∀ i : Information O, Below i i) ∧
    (∀ i j k : Information O, Below i j → Below j k → Below i k) ∧
    (∀ i j : Information O, Below i j → Below j i → i = j) := by
  refine ⟨fun _ _ _ h => h, fun _ _ _ h k x y e => h x y (k x y e), ?_⟩
  intro i j
  exact Quotient.inductionOn₂ (motive := fun a b : Information O =>
    Below a b → Below b a → a = b) i j (fun p q h k =>
      Quotient.sound (s := mutualRefinement O)
        (show Coarser p q ∧ Coarser q p from ⟨h, k⟩))

/-- Factorization through the actually observed quotient is equivalent
    to the information inequality, constructively. -/
theorem coarser_iff_quotient_factor (p q : Projection O) :
    Coarser p q ↔
      ∃ f : Quotient (kernel (classOf q)) → p.View,
        ∀ x, f (Quotient.mk (kernel (classOf q)) x) = p.read x := by
  constructor
  · intro h
    exact ⟨Quotient.lift p.read (fun x y e => h x y e), fun _ => rfl⟩
  · rintro ⟨f, hf⟩ x y e
    have he : Quotient.mk (kernel (classOf q)) x =
        Quotient.mk (kernel (classOf q)) y := Quotient.sound e
    exact (hf x).symm.trans ((congrArg f he).trans (hf y))

def ofSetoid (s : Setoid O) : Information O :=
  classOf ⟨Quotient s, Quotient.mk s⟩

theorem agrees_ofSetoid (s : Setoid O) (x y : O) :
    agrees (ofSetoid s) x y ↔ s.r x y :=
  ⟨Quotient.exact, Quotient.sound⟩

private def commonKernel (p q : Information O) : Setoid O where
  r := fun x y => agrees p x y ∧ agrees q x y
  iseqv := ⟨fun x => ⟨(kernel p).iseqv.refl x, (kernel q).iseqv.refl x⟩,
    fun h => ⟨(kernel p).iseqv.symm h.1, (kernel q).iseqv.symm h.2⟩,
    fun h k => ⟨(kernel p).iseqv.trans h.1 k.1,
      (kernel q).iseqv.trans h.2 k.2⟩⟩

/-- The least common refinement distinguishes what either input can
    distinguish. Equality of its readings means agreement in both views. -/
def join (p q : Information O) : Information O := ofSetoid (commonKernel p q)

theorem join_lub (p q r : Information O) :
    Below (join p q) r ↔ Below p r ∧ Below q r := by
  constructor
  · intro h
    exact ⟨fun x y e => ((agrees_ofSetoid (commonKernel p q) x y).1 (h x y e)).1,
      fun x y e => ((agrees_ofSetoid (commonKernel p q) x y).1 (h x y e)).2⟩
  · rintro ⟨hp, hq⟩ x y e
    exact (agrees_ofSetoid (commonKernel p q) x y).2 ⟨hp x y e, hq x y e⟩

/-- The equivalence relation generated by indistinguishability in either
    input. In particular, one may alternate between the two relations. -/
inductive Zigzag (p q : Information O) : O → O → Prop where
  | left {x y} : agrees p x y → Zigzag p q x y
  | right {x y} : agrees q x y → Zigzag p q x y
  | refl (x) : Zigzag p q x x
  | symm {x y} : Zigzag p q x y → Zigzag p q y x
  | trans {x y z} : Zigzag p q x y → Zigzag p q y z → Zigzag p q x z

private def mixedKernel (p q : Information O) : Setoid O where
  r := Zigzag p q
  iseqv := ⟨Zigzag.refl, Zigzag.symm, Zigzag.trans⟩

/-- The greatest common coarsening identifies precisely the outcomes
    joined by a finite zigzag. -/
def meet (p q : Information O) : Information O := ofSetoid (mixedKernel p q)

theorem meet_glb (p q r : Information O) :
    Below r (meet p q) ↔ Below r p ∧ Below r q := by
  constructor
  · intro h
    exact ⟨fun x y e => h x y ((agrees_ofSetoid (mixedKernel p q) x y).2 (.left e)),
      fun x y e => h x y ((agrees_ofSetoid (mixedKernel p q) x y).2 (.right e))⟩
  · rintro ⟨hp, hq⟩ x y e
    have hz : Zigzag p q x y := (agrees_ofSetoid (mixedKernel p q) x y).1 e
    clear e
    induction hz with
    | left h => exact hp _ _ h
    | right h => exact hq _ _ h
    | refl a => exact (kernel r).iseqv.refl a
    | symm _ ih => exact (kernel r).iseqv.symm ih
    | trans _ _ ih₁ ih₂ => exact (kernel r).iseqv.trans ih₁ ih₂

def pull (f : X → O) (p : Projection O) : Projection X :=
  ⟨p.View, fun x => p.read (f x)⟩

/-- Precomposing both projectors by the same outcome map preserves
    refinement on its whole domain. -/
theorem pull_mono (f : X → O) {p q : Projection O} (h : Coarser p q) :
    Coarser (pull f p) (pull f q) :=
  fun x y e => h (f x) (f y) e

/-- Substituting a middle outcome with the same inner reading may not
    change the requested outer reading. -/
def Compatible (f : X → O) (outer : Projection O) (inner : Projection X) : Prop :=
  Coarser (pull f outer) inner

theorem compatible_comp (f : X → O) (g : Y → X) (p : Projection O)
    (q : Projection X) (r : Projection Y)
    (hf : Compatible f p q) (hg : Compatible g q r) :
    Compatible (fun y => f (g y)) p r :=
  fun x y e => hf (g x) (g y) (hg x y e)

/-- Supply a projector's equality check to the existing hop model. -/
def compareView (p : Projection O) [DecidableEq p.View] (x y : O) : Bool :=
  decide (p.read x = p.read y)

theorem hopCorrect_coarsen (A B : ExecModel) (T : A.Rep → B.Raw)
    (obs : B.Outcome → A.Outcome) (p q : Projection A.Outcome)
    [DecidableEq p.View] [DecidableEq q.View] (hpq : Coarser p q)
    (h : hopCorrect A B T obs (compareView q)) :
    hopCorrect A B T obs (compareView p) := by
  apply (hopCorrect_iff_exact _ _ _ _ _).2
  intro c hc ha
  obtain ⟨rep, hs, hb, he⟩ := (hop_admissible_iff _ _ _ _ _ c).1
    ((hopCorrect_iff_exact _ _ _ _ _).1 h c hc ha)
  exact (hop_admissible_iff _ _ _ _ _ c).2
    ⟨rep, hs, hb, decide_eq_true (hpq _ _ (of_decide_eq_true he))⟩

/-- Middle readings need only determine the outer reading. The middle
    quotient law aligns the raw and class evaluations of the same program. -/
theorem hop_seq_correct_compatible (A B C : ExecModel)
    (T12 : A.Rep → B.Raw) (obs12 : B.Outcome → A.Outcome)
    (T23 : B.Rep → C.Raw) (obs23 : C.Outcome → B.Outcome)
    (p : Projection A.Outcome) (q : Projection B.Outcome)
    [DecidableEq p.View] [DecidableEq q.View] (hc : Compatible obs12 p q)
    (hBC : hopCorrect B C T23 obs23 (compareView q)) (hqB : quotientFactorization B) :
    hopCorrect (hopModel A B T12 obs12 (compareView p)) C T23
      (fun o => obs12 (obs23 o)) (compareView p) := by
  apply (hopCorrect_iff_exact _ _ _ _ _).2
  intro c _ ha
  obtain ⟨pA, hsA, haB, hAB⟩ := (hop_admissible_iff A B T12 obs12 _ c).1 ha
  have okB := (hopCorrect_iff_exact _ _ _ _ _).1 hBC
    (B.q (T12 pA)) ⟨T12 pA, rfl⟩ haB
  obtain ⟨pB, hsB, haC, hCB⟩ := (hop_admissible_iff B C T23 obs23 _ _).1 okB
  have eb : q.read (obs23 (C.evalRaw (T23 pB))) = q.read (B.evalClass (B.q (T12 pA))) :=
    of_decide_eq_true hCB
  have raw := eb.trans (congrArg q.read (hqB (T12 pA)).symm)
  have ea : p.read (obs12 (B.evalRaw (T12 pA))) = p.read (A.evalClass c) :=
    of_decide_eq_true hAB
  apply (hop_admissible_iff _ _ _ _ _ c).2
  refine ⟨pB, ?_, haC, decide_eq_true ((hc _ _ raw).trans ea)⟩
  rw [hop_sigma_eq A B T12 obs12 _ c pA hsA haB hAB]
  exact hsB

/-! ## Projections of an instrumented run

`H` is the consumer's type of heap-count readings. For example it may
record counts indexed by address. The theory does not fix a heap layout
or assume the instrumentation implements either compiler pass.
-/

structure Run (V H : Type) where
  value : V
  heapCounts : H
  steps : Nat
  peakMemory : Nat

variable {V H : Type}

def valueOnly : Projection (Run V H) :=
  ⟨V, Run.value⟩

def valueHeap : Projection (Run V H) :=
  ⟨V × H, fun o => (o.value, o.heapCounts)⟩

def valueSteps : Projection (Run V H) :=
  ⟨V × Nat, fun o => (o.value, o.steps)⟩

def valuePeak : Projection (Run V H) :=
  ⟨V × Nat, fun o => (o.value, o.peakMemory)⟩

theorem value_coarsenings (V H : Type) :
    Coarser (valueOnly : Projection (Run V H)) valueHeap ∧
    Coarser (valueOnly : Projection (Run V H)) valueSteps ∧
    Coarser (valueOnly : Projection (Run V H)) valuePeak :=
  ⟨coarser_of_factor _ _ Prod.fst (fun _ => rfl),
    coarser_of_factor _ _ Prod.fst (fun _ => rfl),
    coarser_of_factor _ _ Prod.fst (fun _ => rfl)⟩

/-- Heap counts and steps can vary independently even at one value. -/
theorem heap_steps_incomparable :
    ¬ Coarser (valueHeap : Projection (Run Unit Nat)) valueSteps ∧
    ¬ Coarser (valueSteps : Projection (Run Unit Nat)) valueHeap := by
  constructor
  · intro h
    have e := h ⟨(), 0, 0, 0⟩ ⟨(), 1, 0, 0⟩ rfl
    exact (by decide : (0 : Nat) ≠ 1) (congrArg Prod.snd e)
  · intro h
    have e := h ⟨(), 0, 0, 0⟩ ⟨(), 0, 1, 0⟩ rfl
    exact (by decide : (0 : Nat) ≠ 1) (congrArg Prod.snd e)

/-- If the outer client exposes a heap count, a pure value at the
    boundary cannot support arbitrary middle substitutions. -/
theorem exposing_heap_needs_counts :
    ¬ Compatible (fun r : Run Unit Nat => r.heapCounts)
      (⟨Nat, id⟩ : Projection Nat) valueOnly := by
  intro h
  exact (by decide : (0 : Nat) ≠ 1) (h ⟨(), 0, 0, 0⟩ ⟨(), 1, 0, 0⟩ rfl)


end NfCompose.Observation
